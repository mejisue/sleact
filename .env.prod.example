# Database
DB_NAME=sleact
DB_USERNAME=sleact_user
DB_PASSWORD=your_db_password
DB_ROOT_PASSWORD=your_root_password

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_chars
JWT_EXPIRATION=3000

# AWS SES (이메일 발송)
AWS_SES_REGION=ap-northeast-2
AWS_SES_SMTP_USERNAME=your_ses_smtp_username
AWS_SES_SMTP_PASSWORD=your_ses_smtp_password

# Mail
MAIL_FROM=noreply@yourdomain.com

# App URL
APP_BASE_URL=https://sleact.yourdomain.com
WEBSOCKET_ALLOWED_ORIGINS=https://sleact.yourdomain.com

# GHCR (GitHub Container Registry)
GITHUB_REPOSITORY_OWNER=mejisue
