# =====================
# Database (AWS RDS)
# =====================
DB_HOST=your-rds-endpoint.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=sleact
DB_USERNAME=
DB_PASSWORD=

# =====================
# JWT
# =====================
JWT_SECRET_KEY=
JWT_EXPIRATION=3000

# =====================
# AWS SES (메일)
# =====================
AWS_SES_REGION=ap-northeast-2
AWS_SES_SMTP_USERNAME=
AWS_SES_SMTP_PASSWORD=
MAIL_FROM=

# =====================
# App URL
# =====================
APP_BASE_URL=https://yourdomain.com
WEBSOCKET_ALLOWED_ORIGINS=https://yourdomain.com

# =====================
# Frontend Build
# =====================
VITE_API_BASE_URL=https://yourdomain.com/api
VITE_WS_BASE_URL=https://yourdomain.com
